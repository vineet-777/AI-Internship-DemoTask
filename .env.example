# PostgreSQL is required by the runtime ingestion command.
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5432/ai_intelligence

# Required for sustained GitHub metadata enrichment beyond GitHub's anonymous
# request budget. Use a token scoped only to public-repository metadata.
GITHUB_TOKEN=

# LLM provider credentials. Keep real keys only in the local .env file.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Optional override for local, content-addressed raw evidence storage.
RAW_STORAGE_ROOT=data/raw
